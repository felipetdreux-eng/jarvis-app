{
  "name": "jarvis-app",
  "version": "0.12.1",
  "description": "Abre a pagina do seu Jarvis na area de trabalho e lanca abas e programas.",
  "main": "main.js",
  "author": "Felipe",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --x64 --publish never",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "32.3.3",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "app.jarvis.desktop",
    "productName": "Jarvis",
    "files": [
      "main.js",
      "preload.js",
      "shell.html",
      "chat.html",
      "config.example.json",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "10.15.0",
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O Jarvis usa o microfone para voce falar com ele."
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}